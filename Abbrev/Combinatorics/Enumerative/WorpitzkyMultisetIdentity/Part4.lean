section

namespace MetaMathlibExt

abbrev wmiWords (m : ℕ) (k : Fin m → ℕ) :=
  { w : Fin (∑ i, k i) → Fin m //
    ∀ i, Fintype.card { j : Fin (∑ i, k i) // w j = i } = k i }

end MetaMathlibExt
