section

namespace MetaMathlibExt

abbrev wmiPairSymData (m K x : ℕ) (k : Fin m → ℕ) :=
  { S : Sym (Fin x ×ₗ Fin m) K //
    ∀ i, (S.val.filter (fun q => (ofLex q).2 = i)).card = k i }

end MetaMathlibExt
