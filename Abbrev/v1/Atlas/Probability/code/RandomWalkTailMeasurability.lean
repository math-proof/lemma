module

public import Mathlib.Probability.Independence.ZeroOne
public import Mathlib.Probability.IdentDistrib
public import Mathlib.MeasureTheory.Measure.MeasureSpace
public import Mathlib.Topology.Instances.EReal.Lemmas
public import Mathlib.Topology.Algebra.Order.LiminfLimsup
public import Abbrev.v1.Atlas.Probability.code.TailSigmaAlgebra
public import Def.Probability.RandomWalkDichotomy
@[expose] public section

set_option maxHeartbeats 4000000

open MeasureTheory ProbabilityTheory Filter Finset Topology MeasurableSpace

variable {Ω : Type*}


namespace RandomWalkTailMeasurability

/-- The natural filtration of σ-algebras `σ(Xₙ)` generated by a sequence `X : ℕ → Ω → ℝ`
of random variables, indexed by `n`. -/
abbrev sigmaAlg (X : ℕ → Ω → ℝ) : ℕ → MeasurableSpace Ω :=
  fun n => MeasurableSpace.comap (X n) inferInstance

end RandomWalkTailMeasurability
