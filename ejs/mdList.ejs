<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<style>
  body { margin: 0; background: #fff; color: #202124; font: 16px/1.5 sans-serif; }
  main { padding: 28px 20px 80px; }
  h1 { font-size: 20px; font-weight: 500; margin: 0 0 16px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 6px 0; }
  a { color: #1a0dab; }
</style>
</head>
<body>
<main>
<h1><%= title %></h1>
<ul>
<% if (parent) { %>
<li><a href="<%= parent %>">../</a></li>
<% } %>
<% for (const row of rows) { %>
<li><a href="<%= row.href %>"><%= row.label %></a></li>
<% } %>
</ul>
</main>
</body>
</html>
