<!DOCTYPE html>
<meta charset="UTF-8">
<base href="/<%= userSegment %>/">
<link rel="stylesheet" href="css/style.css">
<title>search</title>
<% if (loadKatex) { %>
<link rel="stylesheet" href="node_modules/katex/dist/katex.min.css">
<% } %>
<body></body>

<script src="node_modules/axios/dist/axios.min.js" defer></script>
<script src="node_modules/qs/dist/qs.js" defer></script>
<script src="node_modules/clipboard/dist/clipboard.min.js" defer></script>
<script src="node_modules/file-saver/dist/FileSaver.min.js" defer></script>
<script src="js/py.js" defer></script>
<script src="js/std.js" defer></script>
<link rel="stylesheet" href="dist/vue/assets/style.css">
<script type="module" src="dist/vue/pages.js"></script>
<script type="module" src="js/utility.js"></script>
<% if (loadKatex) { %>
<script src="node_modules/katex/dist/katex.min.js" defer></script>
<script src="node_modules/katex/dist/contrib/auto-render.min.js" defer></script>
<% } %>

<script type="module">
window.__appReady = createApp('searchResult', <%- searchJson %>);
