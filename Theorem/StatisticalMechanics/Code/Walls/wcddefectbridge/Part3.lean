open Classical in

theorem wcd_turnZ_probe (K : Set (Site 2)) (e : Dart) :
    turnZ K e =
      (if wcd_frontCell e ∈ K then 1 else if wcd_sideCell e ∈ K then 0 else -1) := by
  classical
  unfold turnZ wcd_frontCell wcd_sideCell; rfl


