namespace StatMech

namespace Lattice

theorem mem_transSet (w : Site 2) (K : Set (Site 2)) (x : Site 2) :
    x ∈ transSet w K ↔ x - w ∈ K := by
  unfold transSet
  constructor
  · rintro ⟨y, hy, rfl⟩; simpa using hy
  · intro h; exact ⟨x - w, h, sub_add_cancel x w⟩


end Lattice
end StatMech
