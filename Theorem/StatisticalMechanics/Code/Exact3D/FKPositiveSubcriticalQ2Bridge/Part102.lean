theorem boxVert_eq_of_hasCoords3
    {n : ℕ} {v w : FK.boxVerts 3 n} {x y z : ℤ}
    (hv : boxVertHasCoords3 v x y z)
    (hw : boxVertHasCoords3 w x y z) :
    v = w := by
  apply Subtype.ext
  funext i
  fin_cases i
  · exact hv.1.trans hw.1.symm
  · exact hv.2.1.trans hw.2.1.symm
  · exact hv.2.2.trans hw.2.2.symm


end Exact3D
end StatMech
