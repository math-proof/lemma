namespace StatMech

namespace Exact3D

theorem finiteBoundaryGhostOnePointSourceCutoff_mem
    {n : ℕ}
    (Ω : Finset
      (↥(Sharpness.withGhost (FK.boxGraph 3 n)).edgeFinset → ℕ))
    (m : ↥(Sharpness.withGhost (FK.boxGraph 3 n)).edgeFinset → ℕ) :
    m ∈ finiteBoundaryGhostOnePointSourceCutoff Ω ↔
      m ∈ Ω ∧ finiteBoundaryGhostFullSourceOnePoint n m := by
  classical
  simp [finiteBoundaryGhostOnePointSourceCutoff,
    finiteBoundaryGhostFullSourceOnePoint]


theorem finiteBoundaryGhostOnePointSourceCutoff_eq_filter_fullSourceOnePoint
    {n : ℕ}
    (Ω : Finset
      (↥(Sharpness.withGhost (FK.boxGraph 3 n)).edgeFinset → ℕ)) :
    finiteBoundaryGhostOnePointSourceCutoff Ω =
      Ω.filter (fun m => finiteBoundaryGhostFullSourceOnePoint n m) := by
  classical
  ext m
  simp [finiteBoundaryGhostOnePointSourceCutoff,
    finiteBoundaryGhostFullSourceOnePoint]


end Exact3D
end StatMech
