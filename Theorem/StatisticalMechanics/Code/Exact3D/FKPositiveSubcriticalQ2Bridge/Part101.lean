theorem boxVertTransverseHeight3_le_two_mul
    {n : ℕ} (v : FK.boxVerts 3 n) :
    boxVertTransverseHeight3 v ≤ 2 * n := by
  unfold boxVertTransverseHeight3
  have h1 : ((v : Lattice.Site 3) (1 : Fin 3)).natAbs ≤ n :=
    v.property (1 : Fin 3)
  have h2 : ((v : Lattice.Site 3) (2 : Fin 3)).natAbs ≤ n :=
    v.property (2 : Fin 3)
  omega


end Exact3D
end StatMech
