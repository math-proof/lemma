import Def.StatisticalMechanics.Code.FrontierA.IsingSurfaceTensionNOneCertificateCore.Part3
import Def.StatisticalMechanics.Code.FrontierA.NOneCertificateChunks.Chunk160.Part3


namespace StatMech.FrontierA.NOneSymmetricMeanCertificate

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 100000000 in
theorem coefficientChunk160_checked :
    rawMomentCoefficientSmallList 320 2 = generatedCoefficientChunk160 := by
  unfold rawMomentCoefficientSmallList
  change addCoefficientLists
    (addCoefficientLists (List.replicate 800 0)
      (rawMomentStateCoefficientList 320))
    (rawMomentStateCoefficientList 321) = generatedCoefficientChunk160
  rw [stateCoefficients320_checked, stateCoefficients321_checked]
  rfl

end StatMech.FrontierA.NOneSymmetricMeanCertificate
