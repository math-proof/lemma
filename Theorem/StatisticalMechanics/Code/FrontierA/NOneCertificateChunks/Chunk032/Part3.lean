import Def.StatisticalMechanics.Code.FrontierA.NOneCertificateChunks.Chunk032.Part3


namespace StatMech.FrontierA.NOneSymmetricMeanCertificate

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 100000000 in
theorem coefficientChunk32_checked :
    rawMomentCoefficientSmallList 64 2 = generatedCoefficientChunk32 := by
  unfold rawMomentCoefficientSmallList
  change addCoefficientLists
    (addCoefficientLists (List.replicate 800 0)
      (rawMomentStateCoefficientList 64))
    (rawMomentStateCoefficientList 65) = generatedCoefficientChunk32
  rw [stateCoefficients64_checked, stateCoefficients65_checked]
  rfl

end StatMech.FrontierA.NOneSymmetricMeanCertificate
