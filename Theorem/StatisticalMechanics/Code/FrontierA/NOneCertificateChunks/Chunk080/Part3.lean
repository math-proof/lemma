set_option maxHeartbeats 100000000 in
theorem coefficientChunk80_checked :
    rawMomentCoefficientSmallList 160 2 = generatedCoefficientChunk80 := by
  unfold rawMomentCoefficientSmallList
  change addCoefficientLists
    (addCoefficientLists (List.replicate 800 0)
      (rawMomentStateCoefficientList 160))
