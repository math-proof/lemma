/-- The inverse action undoes the action. -/
theorem btAct_inv (w : FreeGroup (Fin 2)) (x : btE) :
    btAct w⁻¹ (btAct w x) = x := by
  rw [← btAct_mul, inv_mul_cancel, btAct_one]

