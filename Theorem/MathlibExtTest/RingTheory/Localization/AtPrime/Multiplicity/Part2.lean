import Lemma.Int.Localization.AtPrime.Multiplicity
import Mathlib.RingTheory.DedekindDomain.Different
import Instance.MathlibExtTest.RingTheory.Localization.AtPrime.Multiplicity
set_option autoImplicit false

/-!
# Tests for ideal multiplicity under localization at a maximal ideal

Examples exercising `IsLocalization.AtPrime.emultiplicity_maximalIdeal_map_eq`:
the generic canonical-localization application, the number-theory
specialization to `differentIdeal A B`, the correction-term specialization to
`Ideal.span {(e : B)}`, and a concrete integer localization at the prime `(5)`.
-/


/-- Concrete integer localization at the prime ideal generated by `5`: fully
closed, all instances inferred. -/
example :
    emultiplicity
        (IsLocalRing.maximalIdeal
          (Localization.AtPrime (Ideal.span {(5 : ℤ)})))
        ((Ideal.span {(5 : ℤ)}).map
          (algebraMap ℤ (Localization.AtPrime (Ideal.span {(5 : ℤ)})))) =
      emultiplicity (Ideal.span {(5 : ℤ)}) (Ideal.span {(5 : ℤ)}) :=
  IsLocalization.AtPrime.emultiplicity_maximalIdeal_map_eq _ _

