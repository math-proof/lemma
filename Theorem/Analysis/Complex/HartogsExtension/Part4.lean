namespace Complex.HartogsWanted

open MeasureTheory Set

open scoped Convolution

theorem hartogsext_single_eq_smul
    {n : ℕ} (i : Fin n) (z : ℂ) :
    EuclideanSpace.single i z = z • EuclideanSpace.single i 1 := by
  ext j
  by_cases hji : j = i
  · subst j
    simp
  · simp [hji]

end Complex.HartogsWanted
