-/
@[path]
private lemma finsetSubtype_internal_injective_route_surjective_eq
  {Ω : Finset α}
  {route : {x : α // x ∈ Ω} → α}
  {y : α}
-- given
  (hinj : Function.Injective route)
  (hinternal : ∀ x : {x : α // x ∈ Ω}, route x ∈ Ω)
  (hy : y ∈ Ω) :
-- imply
  ∃ x : {x : α // x ∈ Ω}, route x = y := by
-- proof
  apply StatMech.Exact3D.finsetSubtype_internal_injective_route_surjective hinj hinternal y hy

/--
[finsetSubtype_internal_injective_route_sum_eq](https://github.com/facebookresearch/atlas-lean/blob/main/Atlas/StatisticalMechanics/Code/Exact3D/RandomCurrentPredecessorComparison.lean)
-/
@[path]
private lemma finsetSubtype_internal_injective_route_sum_eq_eq
  [AddCommMonoid M]
  {Ω : Finset α}
  {route : {x : α // x ∈ Ω} → α}
  {W : α → M}
-- given
  (hinj : Function.Injective route)
  (hinternal : ∀ x : {x : α // x ∈ Ω}, route x ∈ Ω) :
-- imply
  (∑ x ∈ Ω.attach, W (route x)) = ∑ y ∈ Ω, W y := by
-- proof
  apply StatMech.Exact3D.finsetSubtype_internal_injective_route_sum_eq hinj hinternal W

/--
[finsetSubtype_internal_injective_route_pointwise_mul_sum_le](https://github.com/facebookresearch/atlas-lean/blob/main/Atlas/StatisticalMechanics/Code/Exact3D/RandomCurrentPredecessorComparison.lean)
-/
@[path]
private lemma finsetSubtype_internal_injective_route_pointwise_mul_sum_le_eq
  {Ω : Finset α}
  {route : {x : α // x ∈ Ω} → α}
  {F W : α → ℝ}
  {c : ℝ}
-- given
  (hinj : Function.Injective route)
  (hinternal : ∀ x : {x : α // x ∈ Ω}, route x ∈ Ω)
  (hpoint : ∀ y : α, ∀ hy : y ∈ Ω, F y ≤ c * W (route ⟨y, hy⟩)) :
-- imply
  (∑ y ∈ Ω, F y) ≤ c * ∑ y ∈ Ω, W y := by
-- proof
  apply StatMech.Exact3D.finsetSubtype_internal_injective_route_pointwise_mul_sum_le hinj hinternal F W c hpoint

