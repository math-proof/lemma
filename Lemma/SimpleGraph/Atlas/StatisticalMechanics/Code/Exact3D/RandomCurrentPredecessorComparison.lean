-/
@[path]
private lemma finset_singleton_symmDiff_singleton_eq_pair_eq
  [DecidableEq α]
  {u v : α}
-- given
  (huv : u ≠ v) :
-- imply
  ({u} : Finset α) ∆ {v} = {u, v} := by
-- proof
  apply StatMech.Exact3D.finset_singleton_symmDiff_singleton_eq_pair huv

