/--
[finsetSubtype_external_route_pointwise_mul_sum_le_image_sum](https://github.com/facebookresearch/atlas-lean/blob/main/Atlas/StatisticalMechanics/Code/Exact3D/RandomCurrentPredecessorComparison.lean)
-/
@[path]
private lemma finsetSubtype_external_route_pointwise_mul_sum_le_image_sum_eq
  [DecidableEq α]
  {Ω : Finset α}
  {route : {x : α // x ∈ Ω} → α}
  {F W : α → ℝ}
  {c : ℝ}
-- given
  (hinj : Function.Injective route)
  (hpoint : ∀ x : {x : α // x ∈ Ω}, route x ∉ Ω → F x.1 ≤ c * W (route x)) :
-- imply
  (∑ x ∈ Ω.attach.filter (fun x => route x ∉ Ω), F x.1) ≤ c * ∑ y ∈ (Ω.attach.filter (fun x => route x ∉ Ω)).image route, W y := by
-- proof
  apply StatMech.Exact3D.finsetSubtype_external_route_pointwise_mul_sum_le_image_sum hinj F W c hpoint

