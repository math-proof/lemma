import Mathlib
import sympy.Basic

open MvPolynomial

/--
Xⱼ is a non-zero-divisor modulo the ideal generated by earlier variables
(atlas X_nonzerodiv_mod_lower).

[X_nonzerodiv_mod_lower](https://github.com/facebookresearch/atlas-lean/blob/main/v1/Atlas/LieGroups/code/SyzygiesKoszul.lean)
-/
@[path]
private lemma main
  [Field k]
  {n : ℕ}
  {j : Fin n}
  {p : MvPolynomial (Fin n) k}
-- given
  (hp : X j * p ∈ Ideal.span (X '' {i : Fin n | (i : ℕ) < (j : ℕ)})) :
-- imply
  p ∈ Ideal.span (X '' {i : Fin n | (i : ℕ) < (j : ℕ)}) := by
-- proof
  rw [mem_ideal_span_X_image] at hp ⊢
  intro m hm
  have hcoeff : p.coeff m ≠ 0 := mem_support_iff.mp hm
  have hcoeff2 : (X j * p).coeff (Finsupp.single j 1 + m) ≠ 0 := by
    rw [coeff_X_mul]; exact hcoeff
  obtain ⟨i, hi_lt, hi_ne⟩ := hp _ (mem_support_iff.mpr hcoeff2)
  refine ⟨i, hi_lt, ?_⟩
  have hij : j ≠ i := by intro h; subst h; exact Nat.lt_irrefl _ hi_lt
  rwa [Finsupp.add_apply, Finsupp.single_apply, if_neg hij, zero_add] at hi_ne


