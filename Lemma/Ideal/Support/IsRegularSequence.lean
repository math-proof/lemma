import Mathlib

/-!
Ideal-owned definition of a finite regular sequence (atlas IsRegularSequence).
Kept here so Ideal lemmas do not import the broken SyzygiesKoszul dump.
-/

/--
A sequence `f : Fin m → A` is regular if each `f j` is a non-zero-divisor
modulo the ideal generated by earlier terms, and the ideal generated by the
whole sequence is proper.
-/
def IsRegularSequence {A : Type*} [CommRing A] {m : ℕ} (f : Fin m → A) : Prop :=
  (∀ (j : Fin m),
    ∀ (r : A ⧸ Ideal.span (Set.image f {i | (i : ℕ) < j})),
      r ≠ 0 →
        (Ideal.Quotient.mk (Ideal.span (Set.image f {i | (i : ℕ) < j})) (f j)) • r ≠ 0) ∧
  Nontrivial (A ⧸ Ideal.span (Set.range f))
