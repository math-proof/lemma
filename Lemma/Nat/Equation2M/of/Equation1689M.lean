import Mathlib
import sympy.Basic
import sympy.analysis.Misc.equational


/--
[singleton_law](https://github.com/teorth/analysis/blob/main/Analysis/Misc/equational.lean)
-/
@[path]
private lemma main
  [Magma M]
-- given
  (h : Equation1689 M) :
-- imply
  Equation2 M :=
-- proof
  singleton_law h


