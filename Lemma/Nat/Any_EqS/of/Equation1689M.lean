import Mathlib
import sympy.Basic
import Theorem.Analysis.Misc.equational


/--
[lemma3](https://github.com/teorth/analysis/blob/main/Analysis/Misc/equational.lean)
-/
@[path]
private lemma main
  [Magma M]
  {a : M}
-- given
  (h : Equation1689 M) :
-- imply
  ∃ e : M, S e a = a :=
-- proof
  lemma3 h a


