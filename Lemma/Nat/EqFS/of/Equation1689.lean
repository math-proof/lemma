import Mathlib
import sympy.Basic
import sympy.analysis.Misc.equational


/--
[lemma2](https://github.com/teorth/analysis/blob/main/Analysis/Misc/equational.lean)
-/
@[path]
private lemma main
  [Magma M]
  {a : M}
-- given
  (h : Equation1689 M) :
-- imply
  ∃ b c d : M, f b c = S d a :=
-- proof
  lemma2 h a


