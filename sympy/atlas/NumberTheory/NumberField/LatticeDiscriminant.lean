import Mathlib.RingTheory.Discriminant
import Mathlib.RingTheory.FractionalIdeal.Operations

/-!
# Discriminants of lattices

This file defines the discriminant submodule generated by tuples contained in a lattice.

The rigidity statement `latticeDiscriminant_eq_imp_eq` formalizes Lemma 12.10 of
Andrew V. Sutherland's MIT 18.785 Number Theory I (Fall 2021) lecture notes (Lecture 12):
https://ocw.mit.edu/courses/18-785-number-theory-i-fall-2021/
-/

open scoped Matrix

universe u

variable (A K : Type*) {L : Type u} [CommRing A] [Field K] [Field L]
  [Algebra A K] [Algebra K L] [Algebra A L]

/-- The set of discriminants of tuples of the field-extension degree whose entries lie in `M`. -/
def latticeDiscriminantSet [FiniteDimensional K L] [_hAKL : IsScalarTower A K L]
    (M : Submodule A L) : Set K :=
  {d | ∃ b : Fin (Module.finrank K L) → L, (∀ i, b i ∈ M) ∧ d = Algebra.discr K b}

variable [FiniteDimensional K L]

/-- The `A`-submodule generated by discriminants of tuples contained in the lattice `M`. -/
def latticeDiscriminant [_hAKL : IsScalarTower A K L]
    (M : Submodule A L) : Submodule A K :=
  Submodule.span A (latticeDiscriminantSet A K M)
