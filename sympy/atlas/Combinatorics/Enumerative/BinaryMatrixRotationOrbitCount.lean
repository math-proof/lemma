import Mathlib.Logic.Equiv.Fin.Basic
import Mathlib.Tactic.Abel

namespace MetaMathlibExt

open scoped BigOperators

/-- Invariance of a `Bool`-valued function under adding `g` extends to all integer
multiples of `g`. -/
private theorem inv_zsmul {G : Type*} [AddCommGroup G] (g : G) (f : G → Bool)
    (hf : ∀ x, f (x + g) = f x) : ∀ (k : ℤ) (x : G), f (x + k • g) = f x := by
  have hneg : ∀ x, f (x - g) = f x := by
    intro x; have := hf (x - g); simpa using this.symm
  intro k
  induction k using Int.induction_on with
  | zero => intro x; simp
  | succ k ih =>
      intro x
      have h1 : x + ((k : ℤ) + 1) • g = (x + (k : ℤ) • g) + g := by rw [add_one_zsmul]; abel
      rw [h1, hf]; exact ih x
  | pred k ih =>
      intro x
      have h1 : x + (-(k : ℤ) - 1) • g = (x + (-(k : ℤ)) • g) - g := by rw [sub_one_zsmul]; abel
      rw [h1, hneg]; exact ih x

/-- Translation-invariant `Bool`-valued functions on `G` are the same data as functions
on the quotient by the subgroup generated by `g`. -/
private noncomputable def invEquiv {G : Type*} [AddCommGroup G] (g : G) :
    {f : G → Bool // ∀ x, f (x + g) = f x} ≃ ((G ⧸ AddSubgroup.zmultiples g) → Bool) where
  toFun fh := Quotient.lift fh.1 (by
    intro a b hab
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp (QuotientAddGroup.leftRel_apply.mp hab)
    have hb : b = a + k • g := by rw [hk]; abel
    rw [hb, inv_zsmul g fh.1 fh.2 k a])
  invFun F := ⟨fun x => F (QuotientAddGroup.mk x), by
    intro x
    have hmk : (QuotientAddGroup.mk (x + g) : G ⧸ AddSubgroup.zmultiples g)
        = QuotientAddGroup.mk x := by
      rw [QuotientAddGroup.eq]
      exact AddSubgroup.mem_zmultiples_iff.mpr ⟨-1, by simp⟩
    exact congrArg F hmk⟩
  left_inv fh := by ext x; rfl
  right_inv F := by
    ext q
    induction q using Quotient.inductionOn with
    | h x => rfl

/-- The cyclic shift action of `Fin m × Fin n` on binary matrices. -/
private instance shiftAction (m n : ℕ) [NeZero m] [NeZero n] :
    AddAction (Fin m × Fin n) (Fin m → Fin n → Bool) where
  vadd p x := fun r s => x (r + p.1) (s + p.2)
  zero_vadd x := by
    funext r s
    change x (r + (0 : Fin m)) (s + (0 : Fin n)) = x r s
    rw [add_zero, add_zero]
  add_vadd p q x := by
    funext r s
    change x (r + (p.1 + q.1)) (s + (p.2 + q.2)) = x (r + p.1 + q.1) (s + p.2 + q.2)
    rw [add_assoc, add_assoc]

private theorem shift_vadd_apply {m n : ℕ} [NeZero m] [NeZero n]
    (p : Fin m × Fin n) (x : Fin m → Fin n → Bool) (r : Fin m) (s : Fin n) :
    (p +ᵥ x) r s = x (r + p.1) (s + p.2) := rfl

private noncomputable def fixedByEquiv {m n : ℕ} [NeZero m] [NeZero n] (g : Fin m × Fin n) :
    (AddAction.fixedBy (Fin m → Fin n → Bool) g)
      ≃ {F : (Fin m × Fin n) → Bool // ∀ p, F (p + g) = F p} where
  toFun x := ⟨fun p => x.1 p.1 p.2, by
    intro p
    have hx : g +ᵥ x.1 = x.1 := x.2
    have h := congrFun (congrFun hx p.1) p.2
    rw [shift_vadd_apply] at h
    exact h⟩
  invFun F := ⟨fun r s => F.1 (r, s), by
    change g +ᵥ (fun r s => F.1 (r, s)) = (fun r s => F.1 (r, s))
    funext r s
    rw [shift_vadd_apply]
    exact F.2 (r, s)⟩
  left_inv x := by ext r s; rfl
  right_inv F := by ext p; rfl

private instance finAddCyclic (M : ℕ) [NeZero M] : IsAddCyclic (Fin M) := by
  obtain ⟨M', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (NeZero.ne M)
  exact ZMod.instIsAddCyclic (M' + 1)

/-- The weight (binary encoding) of a matrix. -/
private def Wt (m n : ℕ) (x : Fin m → Fin n → Bool) : ℕ :=
  ∑ r : Fin m, ∑ s : Fin n, (if x r s = true then 1 else 0) * 2 ^ (r.val * n + s.val)
end MetaMathlibExt
