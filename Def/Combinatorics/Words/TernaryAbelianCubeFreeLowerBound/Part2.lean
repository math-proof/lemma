  (List.finRange 3).flatMap (fun a0 => (List.finRange 3).flatMap (fun a1 =>
    (List.finRange 3).flatMap (fun a2 => (List.finRange 3).map (fun a3 =>
      ((a0, a1, a2, a3), ((0, 0, 0), (0, 0, 0)))))))

