namespace MetaMathlibExt

noncomputable def mpeConstruct (d : ℕ) (a : Fin (d + 1))
    (L : Finset (Fin (d + 2))) (hL : L.card = a.val + 1) :
    Equiv.Perm (Fin (d + 2)) :=
  Equiv.ofBijective (mpeConstructFun d a L hL)
    (mpeConstructFun_injective d a L hL).bijective_of_finite

