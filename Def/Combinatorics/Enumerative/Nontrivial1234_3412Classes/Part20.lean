def ntCert7Entry (s : List ℕ) : ℕ :=
  let rank := ntLehmer s
  (ntCert7Block (rank / 512) (rank / 64 % 8)).getD (rank % 64) 15

def ntDist7 (s : List ℕ) : ℕ :=
  ntCert7Entry s % 16

def ntDeleteCode (s : List ℕ) (y : ℕ) : List ℕ :=
  let v := s.getD y 0
  (s.eraseIdx y).map fun x => if v < x then x - 1 else x

def ntInsertCodeZero (v : ℕ) (s : List ℕ) : List ℕ :=
  v :: s.map fun x => if x < v then x else x + 1

def ntOk7 (s : List ℕ) : Bool :=
  let entry := ntCert7Entry s
  let d := entry % 16
  let q := ntQuads 7
  let i := entry / 16
  (d < 15 || !ntIsGB 7 q s) &&
    (d ≥ 15 || if d = 0 then
      (s == List.range 7 || s == (List.range 5 ++ [6, 5]))
    else i < q.length && match ntNbrAt s (q.getD i (0, 0, 0, 0)) with
      | some t => ntDist7 t + 1 == d
      | none => false)

