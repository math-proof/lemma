import Mathlib.Data.Fin.Basic
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Data.Nat.Totient
import Mathlib.Algebra.Torsor.Defs
import Mathlib.Combinatorics.Colex
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.Logic.Equiv.Fin.Basic
import Mathlib.Tactic.Abel
import Theorem.Combinatorics.Enumerative.BinaryMatrixRotationOrbitCount


namespace MetaMathlibExt

open scoped BigOperators

/-- Translation-invariant `Bool`-valued functions on `G` are the same data as functions
on the quotient by the subgroup generated by `g`. -/
noncomputable def invEquiv {G : Type*} [AddCommGroup G] (g : G) :
    {f : G → Bool // ∀ x, f (x + g) = f x} ≃ ((G ⧸ AddSubgroup.zmultiples g) → Bool) where
  toFun fh := Quotient.lift fh.1 (by
    intro a b hab
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp (QuotientAddGroup.leftRel_apply.mp hab)
    have hb : b = a + k • g := by rw [hk]; abel
    rw [hb, inv_zsmul g fh.1 fh.2 k a])
  invFun F := ⟨fun x => F (QuotientAddGroup.mk x), by
    intro x
    have hmk : (QuotientAddGroup.mk (x + g) : G ⧸ AddSubgroup.zmultiples g)
        = QuotientAddGroup.mk x := by
      rw [QuotientAddGroup.eq]
      exact AddSubgroup.mem_zmultiples_iff.mpr ⟨-1, by simp⟩
    exact congrArg F hmk⟩
  left_inv fh := by ext x; rfl
  right_inv F := by
    ext q
    induction q using Quotient.inductionOn with
    | h x => rfl

end MetaMathlibExt
