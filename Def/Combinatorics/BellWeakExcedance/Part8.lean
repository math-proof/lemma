namespace MetaMathlibExt

noncomputable def minOfBlock {n : ℕ}
    (P : Finpartition (Finset.univ : Finset (Fin n))) (x : Fin n) : Fin n :=
  (P.part x).min' (P.part_nonempty.mpr (Finset.mem_univ x))

end MetaMathlibExt
