namespace StatMech.Universality

open HexWalk

open scoped BigOperators


def hhc_bridgeWeight (x : ℝ) (b : HexBridge) : ℝ :=
  x ^ b.content.length


def hhc_halfWeight (x : ℝ) (s : HexHWContentHalf) : ℝ :=
  (s.1.map (hhc_bridgeWeight x)).prod


end StatMech.Universality
