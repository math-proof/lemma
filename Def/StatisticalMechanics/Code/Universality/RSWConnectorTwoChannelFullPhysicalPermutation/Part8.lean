import Theorem.StatisticalMechanics.Code.Universality.RSWConnectorTwoChannelFibreCube.Part3
import Theorem.StatisticalMechanics.Code.Lattice.CollaredWalkCrossing
import Theorem.StatisticalMechanics.Code.TwoDim.ZhangFaithfulExclusive.Part2
import Theorem.StatisticalMechanics.Code.Universality.RSWConnectorTwoChannelFullPhysicalPermutation.Part6
open Finset SimpleGraph Set


namespace StatMech.Universality

open StatMech.Percolation StatMech.Lattice StatMech.RSW.Box

noncomputable section

noncomputable def rlc_twoChannelFullPhysicalVisibleRightReachSet {n : Int}
    (gamma : RlcRightDiagonalPath n) (gamma' : RlcLeftDiagonalPath n)
    (omega : RlcTwoChannelEdgeConfig gamma gamma') :
    Set (RlcConnectorVertex n) :=
  {z | ∃ x : RlcConnectorVertex n,
    rlc_connectorOnRight gamma x ∧
      (FK.openSub
        (rlc_twoChannelFullPhysicalVisibleSourceGraph gamma gamma')
        (rlc_twoChannelEdgeConfigExtend gamma gamma' omega)).Reachable x z}

end
end StatMech.Universality
