namespace StatMech

namespace Universality

def ccc_FrontierReachesBottom (ω : ConfigSpace (Sym2 (Site 2))) (n : ℤ) : Prop :=
  ∃ (a₀ b₀ : ℤ), 0 ≤ a₀ ∧ a₀ ≤ n - 1 ∧ -1 ≤ b₀ ∧ b₀ ≤ n ∧
    ∀ (r : ℤ), 0 ≤ r → r ≤ n → ∀ (c : ℤ), mbc_IsRightFrontier ω n c r →
      (pmd_boxFaceBarrier ω n).Reachable ![c, r] ![a₀, b₀]


end Universality
end StatMech
