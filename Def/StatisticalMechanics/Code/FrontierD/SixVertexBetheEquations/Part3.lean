namespace StatMech.FrontierD

noncomputable section

noncomputable def sixVertexTheta (c x y : ℝ) : ℝ :=
  y - x + 2 * Real.arctan
    ((Real.sin x - Real.sin y) / sixVertexThetaDenominator c x y)

end
end StatMech.FrontierD
