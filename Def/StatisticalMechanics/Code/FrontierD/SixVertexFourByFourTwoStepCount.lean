def sixVertexFourTwoStepCountExecutable
    (start finish : Fin 16) (grade : Fin 9) : Nat :=
  ∑ middle : Fin 16,
    if sixVertexRowDistance (sixVertexFourRowOfIndex start)
          (sixVertexFourRowOfIndex middle) +
        sixVertexRowDistance (sixVertexFourRowOfIndex middle)
          (sixVertexFourRowOfIndex finish) = grade.val then
      sixVertexFourHorizontalTransitionCount start middle *
        sixVertexFourHorizontalTransitionCount middle finish
    else 0

