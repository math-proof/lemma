import Theorem.StatisticalMechanics.Code.Foundations.Strassen
import Instance.StatisticalMechanics.Code.Foundations.StrassenFull.Part2
open MeasureTheory Finset
open scoped RealInnerProductSpace

set_option linter.style.longLine false
set_option linter.unusedSectionVars false
set_option linter.unusedFintypeInType false


namespace StatMech

section ConfigSpace

variable {E : Type*} [Fintype E] [DecidableEq E]

open ConfigSpace Transport


noncomputable def mass (μ : Measure (ConfigSpace E)) (ω : ConfigSpace E) : ℝ :=
  (μ {ω}).toReal

end ConfigSpace
end StatMech
