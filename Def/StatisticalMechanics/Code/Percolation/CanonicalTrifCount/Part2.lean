open Classical in


noncomputable def ctc2_canonTcount (d : ℕ) (ω : ConfigSpace (Sym2 (Site d))) (n : ℕ) : ℕ :=
  ((boxFinsetBK d n).filter (fun x => IsCanonicalTrifurcation d ω x)).card


