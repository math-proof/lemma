namespace StatMech

namespace Percolation

variable {d : ℕ}


open Classical in


noncomputable def stac_colorOf (ω : ConfigSpace (Sym2 (Site d))) (x₀ : Site d)
    (a : Fin 3 → Site d) (w : Site d) : Fin 3 :=
  if h : ∃ i, Connected d (removeSite x₀ ω) (a i) (fsp_armWitness ω x₀ w) then h.choose else 0


end Percolation
end StatMech
