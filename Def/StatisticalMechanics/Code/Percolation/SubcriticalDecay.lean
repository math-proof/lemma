namespace StatMech

namespace Percolation

open StatMech.Lattice

variable {d : ℕ}


def crossingEvent (d n : ℕ) : Set (ConfigSpace (Sym2 (Site d))) :=
  {ω | ∃ v, Connected d ω (origin d) v ∧ v ∉ box d (n - 1)}

end Percolation
end StatMech
