namespace StatMech

namespace Exact3D

set_option linter.style.longLine false in


noncomputable def edgeCopySourceSectorContainingAndExcludingCopy
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A : Finset V) (m : ↥G.edgeFinset → ℕ)
    (inside outside : Sharpness.FluxEdgeCopy.Copy G m) :
    Finset (Finset (Sharpness.FluxEdgeCopy.Copy G m)) :=
  (edgeCopySourceSector G A m).filter (fun K => inside ∈ K ∧ outside ∉ K)

end Exact3D
end StatMech
