import Theorem.v1.Atlas.AlgebraicGeometryI.code.DimensionTheory
import Lemma.Scheme.Atlas.v1.AlgebraicGeometryI.code.DimensionTheory
import Mathlib.RingTheory.KrullDimension.Polynomial
import Mathlib.RingTheory.KrullDimension.Field
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Class.v1.Atlas.AlgebraicGeometryI.code.ProjectiveIntersection


noncomputable section

open Ideal

/-- The irrelevant ideal of a polynomial ring: the ideal generated by all variables `X_i`. -/
def MvPolynomial.variablesIdeal (k : Type*) [CommSemiring k] (σ : Type*) :
    Ideal (MvPolynomial σ k) :=
  Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ k))

end
