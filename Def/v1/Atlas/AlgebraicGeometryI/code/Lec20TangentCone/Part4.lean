import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.GradedAlgebra.Basic
import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.ReesAlgebra
import Mathlib.AlgebraicGeometry.Scheme
import Theorem.v1.Atlas.AlgebraicGeometryI.code.Lec20TangentCone.Part3
open Polynomial


namespace Lec20TangentCone

universe u

variable {R : Type u} [CommRing R]

/-- The associated graded ring `gr_𝔪(R) = ⨁ 𝔪^n/𝔪^{n+1}`, realised as the quotient
of the Rees algebra by the ideal generated by `𝔪`. -/
def assocGradedRing (𝔪 : Ideal R) : Type _ :=
  (reesAlgebra 𝔪) ⧸ reesIdealFromBase 𝔪

end Lec20TangentCone
