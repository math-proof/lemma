module

public import Mathlib.RingTheory.DiscreteValuationRing.Basic
public import Mathlib.RingTheory.Henselian
public import Mathlib.NumberTheory.Padics.PadicIntegers
public import Mathlib.LinearAlgebra.FreeModule.Basic
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
public import Mathlib.Algebra.Polynomial.Derivative
public import Mathlib.Algebra.Polynomial.Taylor
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.Topology.MetricSpace.Ultra.Basic
public import Mathlib.Analysis.Normed.Field.Basic
public import Structure.v1.Atlas.Buildings.code.Valuation.LatticesValuations

@[expose] public section

open Polynomial Matrix


namespace DVRContext

variable (C : DVRContext)

attribute [instance] DVRContext.inst_field DVRContext.inst_comm_ring DVRContext.inst_domain

/-- *The maximal ideal of $\mathfrak{o}$*: the principal ideal $(\pi) \subseteq \mathfrak{o}$
generated by the chosen uniformizer $\pi$. In a DVR this is the unique maximal ideal. -/
def maxIdeal : Ideal C.𝔬 := Ideal.span {C.uniformizer}

/-- *$\mathfrak{o}$-scalar action on $k^n$*: pointwise multiplication by the image
$\iota(r) \in k$ of $r \in \mathfrak{o}$. Used to express the $\mathfrak{o}$-module structure
of $k^n$ via the embedding $\iota = $`embed`. -/
def oscal (r : C.𝔬) (v : Fin C.n → C.k) : Fin C.n → C.k :=
  fun i => C.embed r * v i

/-- *Predicate "$x \in \mathfrak{o}$"*: an element $x \in k$ lies in the valuation ring iff it
is the image of some $r \in \mathfrak{o}$ under the embedding $\iota$. -/
def isInO (x : C.k) : Prop := ∃ r : C.𝔬, C.embed r = x

/-- *Predicate "$x \in \mathfrak{m}$"*: an element $x \in k$ lies in the maximal ideal iff it
is the image of some $r \in (\pi) \subseteq \mathfrak{o}$. -/
def isInMaxIdeal (x : C.k) : Prop :=
  ∃ r : C.𝔬, r ∈ C.maxIdeal ∧ C.embed r = x

/-- *Predicate "$x \in \mathfrak{o}^\times$"*: an element $x \in k$ is a unit of the valuation
ring iff it is the image of a unit $r \in \mathfrak{o}^\times$. -/
def isUnitInO (x : C.k) : Prop :=
  ∃ r : C.𝔬, IsUnit r ∧ C.embed r = x


/-- *Newton iteration sequence*: starting from $x_0$, iteratively define
$x_{n+1} = x_n - f(x_n) / f'(x_n)$ using `Ring.inverse` for the division. This is the
underlying sequence used in Hensel's lemma to produce a root of $f$. -/
noncomputable def newtonSeq (f : C.𝔬[X]) (x₀ : C.𝔬) : ℕ → C.𝔬 :=
  fun n => Nat.recOn n x₀ fun _ b =>
    b - f.eval b * Ring.inverse ((Polynomial.derivative f).eval b)


end DVRContext
