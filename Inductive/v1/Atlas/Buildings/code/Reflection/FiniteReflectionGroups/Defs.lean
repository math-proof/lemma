module

public import Def.v1.Atlas.Buildings.code.Reflection.HyperplaneChambers.Part4
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.LinearAlgebra.Basis.Basic
public import Mathlib.Data.List.OfFn
public import Mathlib.Data.Set.Finite.Basic
public import Def.v1.Atlas.Buildings.code.Reflection.FiniteReflectionGroups.Defs.Part3
open scoped InnerProductSpace
open Set


noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

namespace FiniteReflectionGroups

variable {Φ : RootSystem E}

/-- Inductive definition of membership in the Weyl group, generated by reflections
$s_α$ for $α ∈ Φ$ under composition. -/
public inductive RootSystem.WeylGroupMem (Φ : RootSystem E) : (E → E) → Prop where
  | id : Φ.WeylGroupMem _root_.id
  | gen (α : E) (hα : α ∈ Φ.roots) : Φ.WeylGroupMem (linearReflection α)
  | comp (f g : E → E) : Φ.WeylGroupMem f → Φ.WeylGroupMem g →
      Φ.WeylGroupMem (f ∘ g)

end FiniteReflectionGroups
end
