class IsAntidominant {k' : Type*} [Field k'] (𝔥star : Type*)
    (posRoots : Set 𝔥star) (pairing : 𝔥star → 𝔥star → k') (lam : 𝔥star) : Prop where
  not_pos_int_pairing : ∀ α ∈ posRoots, ¬(∃ n : ℕ, n > 0 ∧ pairing lam α = (n : k'))

